{
  "name": "cartograph",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.10.1",
  "scripts": {
    "dev": "next dev",
    "ai:verify": "tsc -p tsconfig.ai.json && node --conditions=react-server .cartograph/ai/scripts/ai-verify.js && node .cartograph/ai/scripts/explanation-prose-verify.js",
    "ai:verify:live": "tsc -p tsconfig.ai.json && node --env-file=.env.local --conditions=react-server .cartograph/ai/scripts/ai-live-verify.js",
    "evals:verify": "tsc -p tsconfig.evals.json && node --conditions=react-server .cartograph/evals/scripts/evals-verify.js",
    "evals:verify:live": "tsc -p tsconfig.evals.json && node --conditions=react-server .cartograph/evals/scripts/evals.js verify-live-paths",
    "evals:paths": "tsc -p tsconfig.evals.json && node --conditions=react-server .cartograph/evals/scripts/evals.js paths",
    "evals:dataset:roles": "tsc -p tsconfig.evals.json && node --conditions=react-server .cartograph/evals/scripts/evals.js capture-roles",
    "evals:roles": "tsc -p tsconfig.evals.json && node --conditions=react-server .cartograph/evals/scripts/evals.js roles",
    "evals:dataset:explanations": "tsc -p tsconfig.evals.json && node --conditions=react-server .cartograph/evals/scripts/evals.js capture-explanations",
    "evals:prompts": "tsc -p tsconfig.evals.json && node --conditions=react-server .cartograph/evals/scripts/evals.js prompts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "parser": "tsc -p tsconfig.parser.json && node .cartograph/parser/scripts/parser.js",
    "parser:verify": "tsc -p tsconfig.parser.json && node .cartograph/parser/scripts/parser-verify.js",
    "parser:verify:commonjs": "tsc -p tsconfig.parser.json && node .cartograph/parser/scripts/parser-commonjs-verify.js",
    "map:verify": "tsc -p tsconfig.map.json && node .cartograph/map/scripts/map-verify.js",
    "graph:verify": "tsc -p tsconfig.map.json && node .cartograph/map/scripts/graph-verify.js",
    "adapters:verify": "tsc -p tsconfig.adapters.json && node .cartograph/adapters/scripts/adapters-verify.js",
    "pipeline:verify": "tsc -p tsconfig.pipeline.json && node --conditions=react-server .cartograph/pipeline/scripts/pipeline-verify.js",
    "pipeline:verify:live": "tsc -p tsconfig.pipeline.json && node --env-file=.env.local --conditions=react-server .cartograph/pipeline/scripts/pipeline-verify.js --live"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.10",
    "@dagrejs/dagre": "^3.1.1",
    "@supabase/supabase-js": "2.117.2",
    "@xyflow/react": "^12.12.0",
    "langsmith": "0.10.9",
    "next": "16.3.8",
    "openai": "7.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
